{
  "name": "deskqr",
  "version": "1.0.0",
  "description": "A modern desktop QR code generator and scanner built with Electron, React, and Tailwind CSS",
  "main": "public/main.js",
  "homepage": "./",
  "scripts": {
    "start": "concurrently \"npm run webpack:dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron public/main.js\"",
    "webpack:dev": "webpack serve --mode development",
    "webpack:build": "cross-env NODE_ENV=production webpack --mode production",
    "electron:dev": "cross-env NODE_ENV=development electron public/main.js",
    "build": "npm run webpack:build",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "publish": "npm run build && electron-forge publish",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "qr-code",
    "scanner",
    "generator",
    "electron",
    "react",
    "desktop"
  ],
  "author": "Your Name",
  "license": "MIT",
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "DeskQR",
        "executableName": "DeskQR",
        "icon": "assets/icon",
        "ignore": [
          "src",
          "webpack.config.js",
          "tailwind.config.js",
          "postcss.config.js",
          ".babelrc"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "DeskQR"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin",
            "linux"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "format": "ULFO"
          }
        }
      ]
    }
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "electron": "^34.2.0",
    "electron-reload": "^2.0.0-alpha.1",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.4",
    "style-loader": "^4.0.0",
    "wait-on": "^9.0.1",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^3.0.3",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "qrcode.js": "^0.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0"
  }
}
